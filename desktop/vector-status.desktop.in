[Desktop Entry]
Type=Application
Name=Vector Status
GenericName=Vector Battery and Stats Gauge
Comment=Floating Vector battery/temp/CPU stats when the robot is online
Exec=/usr/bin/python3 @PREFIX@/lib/vector-status/vector-status.py
Icon=@PREFIX@/lib/vector-status/assets/vector-face.png
Terminal=false
Categories=Utility;System;Monitor;
StartupNotify=false
X-GNOME-Autostart-enabled=true
Keywords=vector;anki;wire-pod;battery;robot;gauge;
